#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
BASE=$(git config --get productVersions.baseRef || true)
BASE=${BASE:-origin/develop}

if ! git rev-parse --verify "${BASE}^{commit}" >/dev/null 2>&1; then
    echo "ERROR: configured base ref '$BASE' is unavailable." >&2
    echo "Fetch it, or configure the correct integration branch:" >&2
    echo "  git config productVersions.baseRef origin/main" >&2
    exit 1
fi

echo "Validating data-product versions ($BASE -> HEAD)..."
if ! bash "$REPO_ROOT/scripts/validate-product-versions.sh" "$BASE" HEAD; then
    echo "Push rejected. Update each changed product.yml version, commit it, and push again." >&2
    exit 1
fi
